# TEST-ONLY credentials for the local throwaway OpenMage container.
# Never reuse these anywhere real. bootstrap.sh copies this file to .env
# (gitignored) on first run; edit .env, not this file, to change them.

OPENMAGE_VERSION=20.18.0
OPENMAGE_PORT=18080

# SOAP/XML-RPC web services user created by bootstrap.sh (all resources).
OPENMAGE_API_USER=pytest
OPENMAGE_API_KEY=pytest-api-key-123

# Magento admin login (http://localhost:18080/index.php/admin).
OPENMAGE_ADMIN_USER=admin
OPENMAGE_ADMIN_PASSWORD=admin-test-password-123

DB_NAME=openmage
DB_USER=openmage
DB_PASSWORD=openmage
DB_ROOT_PASSWORD=openmage-root
